{
  "id": "max",
  "kind": "channel",
  "channels": ["max"],
  "name": "MAX Messenger",
  "description": "MAX Messenger channel plugin for OpenClaw",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["max_send_file"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "max": {
      "schema": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "allowFrom": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dmPolicy": {
            "type": "string",
            "enum": ["open", "allowlist", "closed"]
          },
          "webhookUrl": { "type": "string" },
          "webhookSecret": { "type": "string" },
          "apiBaseUrl": { "type": "string" },
          "httpProxy": { "type": "string" },
          "streaming": { "type": "boolean" },
          "groupPolicy": {
            "type": "string",
            "enum": ["open", "allowlist", "disabled"]
          },
          "groupAllowFrom": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requireMention": { "type": "boolean" },
          "notify": { "type": "boolean" },
          "disableLinkPreview": { "type": "boolean" },
          "groups": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "requireMention": { "type": "boolean" },
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      },
      "uiHints": {
        "token": {
          "label": "Bot token",
          "sensitive": true
        },
        "webhookUrl": {
          "label": "Public webhook URL (https://host/max/webhook). Empty = long polling"
        },
        "webhookSecret": {
          "label": "Webhook secret (X-Max-Bot-Api-Secret)",
          "sensitive": true
        },
        "apiBaseUrl": {
          "label": "MAX API base URL",
          "placeholder": "https://platform-api2.max.ru"
        },
        "httpProxy": {
          "label": "HTTP(S) proxy for MAX API traffic only",
          "placeholder": "http://user:pass@host:port"
        },
        "streaming": {
          "label": "Stream replies via message edits (default: on)"
        },
        "notify": {
          "label": "Notify recipients on outbound messages (default: on). Per-message override: channelData.maxNotify"
        },
        "disableLinkPreview": {
          "label": "Suppress link previews in outbound messages (default: off). Per-message override: channelData.maxDisableLinkPreview"
        }
      }
    }
  }
}
